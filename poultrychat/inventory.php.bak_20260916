        <!-- Current Stock -->
        <div class="card p-4 shadow-sm border-0 rounded-4 mb-4">
            <h4 class="card-title mb-4 text-primary fw-bold">
                <i class="fas fa-warehouse me-2"></i>Current Stock
            </h4>
            <div class="table-responsive custom-scrollbar" style="max-height: 350px; overflow-y: auto;">
                <table class="table table-hover align-middle">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Item Name</th>
                            <th>Category</th>
                            <th>Prev. Stock</th>
                            <th>Current Stock</th>
                            <th class="text-end">Total Value</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php
                        try {
                            $stmt = $conn->query("SELECT * FROM inventory ORDER BY category, item_name");
                            while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                                $totalValue = $row['quantity'] * $row['unit_cost'];
                                $stockStatus = $row['quantity'] < 10 ? 'text-danger fw-bold' : 'text-success';
                                echo "<tr>
                                    <td class='fw-bold'>" . e($row['item_name']) . "</td>
                                    <td><span class='badge bg-info-subtle text-info border rounded-pill'>" . e(ucfirst($row['category'])) . "</span></td>
                                    <td class='text-muted small'>{$row['previous_quantity']} " . e($row['unit']) . "</td>
                                    <td class='{$stockStatus}'>{$row['quantity']} " . e($row['unit']) . "</td>
                                    <td class='text-end fw-bold text-primary'>₱" . number_format($totalValue, 2) . "</td>
                                    <td>" . ($row['quantity'] < 10 ? '<span class="badge bg-danger">Low Stock</span>' : '<span class="badge bg-success">In Stock</span>') . "</td>
                                </tr>";
                            }
                        } catch (PDOException $e) {
                            error_log("Stock fetch error: " . $e->getMessage());
                            echo "<tr><td colspan='6' class='text-muted text-center py-3'>Unable to load stock.</td></tr>";
                        }
                        ?>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Usage History -->
        <div class="card p-4 shadow-sm border-0 rounded-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="card-title mb-0 text-primary fw-bold">
                    <i class="fas fa-history me-2"></i>Usage History
                </h4>
                
                <!-- Item Filter -->
                <div class="d-flex align-items-center gap-2">
                    <label class="small fw-bold text-muted text-nowrap">Filter by Item:</label>
                    <select id="itemHistoryFilter" class="form-select form-select-sm rounded-pill" style="width: auto;" onchange="filterUsage(this.value)">
                        <?php
                        $all_items = $conn->query("SELECT inventory_id, item_name, category FROM inventory ORDER BY category, item_name")->fetchAll(PDO::FETCH_ASSOC);
                        $selected_item = isset($_GET['item_filter']) ? $_GET['item_filter'] : 'all';
                        
                        echo "<option value='all' " . ($selected_item == 'all' ? 'selected' : '') . ">-- All Items --</option>";
                        foreach($all_items as $ai) {
                            echo "<option value='{$ai['inventory_id']}' " . ($selected_item == $ai['inventory_id'] ? 'selected' : '') . ">" . e($ai['item_name']) . " (" . e(ucfirst($ai['category'])) . ")</option>";
                        }
                        ?>
                    </select>
                </div>
            </div>

            <div class="table-responsive custom-scrollbar" style="max-height: 350px; overflow-y: auto;">
                <table class="table table-hover align-middle">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Date</th>
                            <th>Batch</th>
                            <th>Item Name</th>
                            <th>Type</th>
                            <th class="text-end">Qty Used</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php
                        try {
                            $where_clauses = [];
                            $feed_where = "";
                            $act_where = "WHERE a.type IN ('Health', 'Supply')";
                            $hr_where = "";
                            $feed_params = [];
                            $act_params = [];
                            $hr_params = [];

                            if ($selected_item != 'all') {
                                $stmt_name = $conn->prepare("SELECT item_name FROM inventory WHERE inventory_id = ?");
                                $stmt_name->execute([$selected_item]);
                                $item_name_val = $stmt_name->fetchColumn();

                                $feed_where = "WHERE f.inventory_id = ?";
                                $act_where = "WHERE a.item_name = ? AND a.type IN ('Health', 'Supply')";
                                $hr_where = "WHERE hr.medicine_name = ?";
                                $feed_params = [$selected_item];
                                $act_params = [$item_name_val];
                                $hr_params = [$item_name_val];
                            }

                            $usage_query = "
                                (SELECT f.date, b.batch_code, i.item_name, 'Feeding' as type, f.quantity_used as quantity, i.unit
                                 FROM feed_consumption f 
                                 JOIN batches b ON f.batch_id = b.batch_id 
                                 JOIN inventory i ON f.inventory_id = i.inventory_id
                                 $feed_where)
                                UNION ALL
                                (SELECT a.date, b.batch_code, a.item_name, a.type, a.quantity, i.unit
                                 FROM activities a 
                                 JOIN batches b ON a.batch_id = b.batch_id
                                 LEFT JOIN inventory i ON a.item_name = i.item_name
                                 $act_where)
                                UNION ALL
                                (SELECT hr.date, b.batch_code, hr.medicine_name as item_name, 'Health' as type, hr.quantity_used as quantity, i.unit
                                 FROM health_records hr
                                 JOIN batches b ON hr.batch_id = b.batch_id
                                 LEFT JOIN inventory i ON hr.medicine_name = i.item_name
                                 $hr_where)
                                ORDER BY date DESC LIMIT 30
                            ";

                            $stmt = $conn->prepare($usage_query);
                            $stmt->execute(array_merge($feed_params, $act_params, $hr_params));
                            $usage = $stmt->fetchAll(PDO::FETCH_ASSOC);

                            if (empty($usage)) {
                                echo "<tr><td colspan='5' class='text-center py-5 text-muted small'><i class='fas fa-info-circle me-2 opacity-50'></i>No usage records found.</td></tr>";
                            }

                            foreach($usage as $u) {
                                $badge_color = 'bg-secondary';
                                if ($u['type'] == 'Feeding') $badge_color = 'bg-warning text-dark';
                                elseif ($u['type'] == 'Health') $badge_color = 'bg-danger';
                                elseif ($u['type'] == 'Supply') $badge_color = 'bg-success';

                                echo "<tr>
                                    <td>" . date('M d, Y', strtotime($u['date'])) . "</td>
                                    <td><span class='badge bg-light text-primary border'>" . e($u['batch_code']) . "</span></td>
                                    <td class='fw-bold'>" . e($u['item_name']) . "</td>
                                    <td><span class='badge {$badge_color} rounded-pill'>" . e(ucfirst($u['type'])) . "</span></td>
                                    <td class='text-end fw-bold text-danger'>-{$u['quantity']} <small class='text-muted fw-normal'>" . e($u['unit']) . "</small></td>
                                </tr>";
                            }
                        } catch (PDOException $e) {
                            error_log("Usage history error: " . $e->getMessage());
                            echo "<tr><td colspan='5' class='text-danger text-center py-3'>Unable to load usage records.</td></tr>";
                        }
                        ?>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
function filterUsage(inventoryId) {
    const url = new URL(window.location);
    url.searchParams.set('item_filter', inventoryId);
    window.location.href = url.href;
}
</script>

