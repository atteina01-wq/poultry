<?php include('database.php'); ?>
<?php include('db_check.php'); ?>
<?php include('header.php'); ?>

<?php
$user_role = strtolower($_SESSION['role'] ?? 'staff');
$isAdmin = ($user_role === 'admin');

// Server-side enforcement for batch creation
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['save'])) {
    if (!$isAdmin) {
        $save_error = "Access denied. Only administrators can register or modify flocks.";
    } else {
        try {
            $batch_code = trim($_POST['batch_code'] ?? '');
            $flock_type = $_POST['flock_type'] ?? '';
            $arrival_date = $_POST['arrival_date'] ?? '';
            $quantity = intval($_POST['quantity'] ?? 0);
            $breed = trim($_POST['breed'] ?? '');
            $house_pen = trim($_POST['house_pen'] ?? '');
            $supplier = trim($_POST['supplier'] ?? '');
            $expected_harvest_date = !empty($_POST['expected_harvest_date']) ? $_POST['expected_harvest_date'] : null;
            
            // Validation
            if ($quantity <= 0) {
                throw new Exception("Initial quantity must be greater than 0");
            }
            if (empty($batch_code)) {
                throw new Exception("Batch code is required");
            }
            if (!in_array($flock_type, ['broiler', 'layer'])) {
                throw new Exception("Invalid flock type");
            }

            // Build the INSERT dynamically so it works on both base and upgraded schemas
            $columns = ['batch_code', 'arrival_date', 'initial_quantity', 'current_quantity', 'supplier', 'status'];
            $params  = [$batch_code, $arrival_date, $quantity, $quantity, $supplier ?: null, 'active'];

            // Detect which optional columns exist
            $col_stmt = $conn->prepare("
                SELECT COLUMN_NAME FROM information_schema.COLUMNS
                WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'batches'
            ");
            $col_stmt->execute();
            $existing = array_column($col_stmt->fetchAll(PDO::FETCH_ASSOC), 'COLUMN_NAME');

            if (in_array('flock_type', $existing)) {
                $columns[] = 'flock_type';
                $params[] = $flock_type;
            }
            if (in_array('breed', $existing)) {
                $columns[] = 'breed';
                $params[] = $breed ?: null;
            }
            if (in_array('house_pen', $existing)) {
                $columns[] = 'house_pen';
                $params[] = $house_pen ?: null;
            }
            if (in_array('expected_harvest_date', $existing)) {
                $columns[] = 'expected_harvest_date';
                $params[] = $expected_harvest_date;
            }
            if (in_array('created_by', $existing)) {
                $columns[] = 'created_by';
                $params[] = $_SESSION['user_id'];
            }

            $sql = "INSERT INTO batches (" . implode(', ', $columns) . ")
                    VALUES (" . implode(', ', array_fill(0, count($columns), '?')) . ")";
            $stmt = $conn->prepare($sql);
            $stmt->execute($params);
            $save_msg = "Batch '{$batch_code}' added successfully!";
        } catch (Exception $e) {
            $save_error = "Error: " . $e->getMessage();
        }
    }
}
?>

<div class="row g-4">
    <?php if ($isAdmin): ?>
    <!-- Register New Batch (Admin Only - Left Side) -->
    <div class="col-lg-4 col-md-5">
        <div class="card p-4 shadow-sm border-0 rounded-4">
            <h3 class="section-title mb-4"><i class="fas fa-plus-circle me-2 text-primary"></i>Register New Batch</h3>
            
            <?php if (isset($save_msg)): ?>
                <div class="alert alert-success shadow-sm mb-4"><i class="fas fa-check-circle me-2"></i><?php echo e($save_msg); ?></div>
            <?php endif; ?>
            <?php if (isset($save_error)): ?>
                <div class="alert alert-danger shadow-sm mb-4"><i class="fas fa-exclamation-circle me-2"></i><?php echo e($save_error); ?></div>
            <?php endif; ?>

            <form method="POST">
                <?php echo csrf_field(); ?>
                <div class="mb-3">
                    <label class="form-label fw-bold">Batch Code</label>
                    <input type="text" name="batch_code" class="form-control" placeholder="e.g. B2024-001" required>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Flock Type</label>
                    <select name="flock_type" class="form-select" required>
                        <option value="">-- Select Type --</option>
                        <option value="broiler">Broiler (Meat)</option>
                        <option value="layer">Layer (Eggs)</option>
                    </select>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Arrival Date</label>
                        <input type="date" name="arrival_date" class="form-control" value="<?php echo date('Y-m-d'); ?>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Initial Qty</label>
                        <input type="number" name="quantity" class="form-control" min="1" required>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Breed</label>
                        <input type="text" name="breed" class="form-control" placeholder="e.g. Lohmann, ISA Brown">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">House/Pen</label>
                        <input type="text" name="house_pen" class="form-control" placeholder="e.g. House A, Pen 1">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Supplier Name</label>
                    <input type="text" name="supplier" class="form-control" placeholder="Enter supplier name">
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Expected Harvest Date</label>
                    <input type="date" name="expected_harvest_date" class="form-control">
                </div>

                <div class="d-grid">
                    <button type="submit" name="save" class="btn btn-primary btn-lg rounded-pill">
                        <i class="fas fa-save me-2"></i>Save Batch Record
                    </button>
                </div>
            </form>
        </div>
        <div class="text-center mt-3">
            <a href="index.php" class="text-decoration-none text-muted small"><i class="fas fa-arrow-left me-1"></i>Back to Home</a>
        </div>
    </div>
    <?php endif; ?>

    <!-- Registered Batches / Flocks Table -->
    <div class="<?php echo $isAdmin ? 'col-lg-8 col-md-7' : 'col-12'; ?>">
        <div class="card p-4 shadow-sm border-0 rounded-4 h-100">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-4">
                <div>
                    <h3 class="section-title mb-1"><i class="fas fa-layer-group me-2 text-primary"></i>Registered Flocks & Houses</h3>
                    <p class="text-muted small mb-0">Active and historical broiler and layer flocks across all houses.</p>
                </div>
                <?php if (!$isAdmin): ?>
                    <span class="badge bg-light text-muted border px-3 py-2"><i class="fas fa-eye me-1 text-primary"></i>Operational Directory (Staff View)</span>
                <?php endif; ?>
            </div>

            <div class="table-responsive custom-scrollbar" style="max-height: 600px; overflow-y: auto;">
                <table class="table table-hover align-middle">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Batch Code</th>
                            <th>Type</th>
                            <th>House / Pen</th>
                            <th>Arrival Date</th>
                            <th>Current Stock</th>
                            <th>Supplier</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php
                        $stmt = $conn->query("SELECT * FROM batches ORDER BY arrival_date DESC");
                        $batches_found = false;
                        while($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
                            $batches_found = true;
                            $isActive = ($row['status'] == 'active');
                            $flockType = ucfirst($row['flock_type'] ?? 'broiler');
                            $flockBadge = ($row['flock_type'] == 'layer') ? 'bg-info-subtle text-info border-info-subtle' : 'bg-warning-subtle text-warning border-warning-subtle';
                            $housePen = !empty($row['house_pen']) ? e($row['house_pen']) : (!empty($row['breed']) ? e($row['breed']) : '<span class="text-muted small">General</span>');
                            
                            echo "<tr>
                                <td>
                                    <span class='fw-bold text-primary'>" . e($row['batch_code']) . "</span>
                                    " . (!empty($row['breed']) && !empty($row['house_pen']) ? "<div class='small text-muted'>" . e($row['breed']) . "</div>" : "") . "
                                </td>
                                <td>
                                    <span class='badge rounded-pill {$flockBadge} border px-3'>
                                        " . e($flockType) . "
                                    </span>
                                </td>
                                <td>{$housePen}</td>
                                <td>" . date('M d, Y', strtotime($row['arrival_date'])) . "</td>
                                <td>
                                    <span class='fw-bold fs-6'>{$row['current_quantity']}</span>
                                    <small class='text-muted ms-1'>/ {$row['initial_quantity']}</small>
                                </td>
                                <td>" . ($row['supplier'] ? e($row['supplier']) : '<span class="text-muted small">Not specified</span>') . "</td>
                                <td>
                                    <span class='badge rounded-pill " . ($isActive ? 'bg-success-subtle text-success border-success-subtle' : 'bg-secondary-subtle text-secondary border-secondary-subtle') . " border px-3'>
                                        " . ucfirst($row['status']) . "
                                    </span>
                                </td>
                            </tr>";
                        }
                        if (!$batches_found) {
                            echo "<tr><td colspan='7' class='text-center text-muted py-4'>No batch records registered yet.</td></tr>";
                        }
                        ?>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

