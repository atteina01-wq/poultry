<?php 
include('database.php'); 
include('db_check.php'); 
include('header.php'); 

$cat = isset($_GET['cat']) ? strtolower(trim($_GET['cat'])) : 'feed';
$is_limestone = ($cat === 'limestone');
$target_category = $is_limestone ? 'limestone' : 'feed';

$section_icon = $is_limestone ? 'fa-mountain text-success' : 'fa-wheat-awn text-warning';
$form_title = $is_limestone ? 'Record Limestone Usage' : 'Record Feed Consumption';
$item_label = $is_limestone ? 'Limestone Item' : 'Feed Item';
$item_placeholder = $is_limestone ? '-- Choose Limestone Item --' : '-- Choose Feed Item --';
$button_text = $is_limestone ? 'Record Limestone Usage' : 'Submit Record';
$history_title = $is_limestone ? 'Limestone Usage History' : 'Feeding History';
$history_col_header = $is_limestone ? 'Limestone Item' : 'Feed Item';
$no_records_msg = $is_limestone ? 'No limestone usage records found.' : 'No feeding records found.';
$success_msg = $is_limestone ? 'Limestone record updated and inventory deducted!' : 'Feed record updated and inventory deducted!';

$message = '';
$error = '';

if (isset($_POST['consume'])) {
    $batch_id = intval($_POST['batch_id'] ?? 0);
    $inventory_id = intval($_POST['inventory_id'] ?? 0);
    $qty = floatval($_POST['qty'] ?? 0);
    $date = date('Y-m-d');

    if ($batch_id <= 0 || $inventory_id <= 0 || $qty <= 0) {
        $error = "Please provide a valid batch, item, and quantity greater than zero.";
    } else {
        if (record_feed_consumption($conn, $batch_id, $inventory_id, $qty, $date)) {
            $message = $success_msg;
        } else {
            $error = "Error recording {$target_category} consumption. Please check available stock.";
        }
    }
}

// Fetch active batches
$stmtBatches = $conn->query("SELECT batch_id, batch_code FROM batches WHERE status='active' ORDER BY batch_code");
$batches = $stmtBatches->fetchAll(PDO::FETCH_ASSOC);

// Fetch items filtered strictly by category (limestone vs feed)
$stmtItems = $conn->prepare("SELECT inventory_id, item_name, quantity, unit FROM inventory WHERE category = ? ORDER BY item_name");
$stmtItems->execute([$target_category]);
$inventory_items = $stmtItems->fetchAll(PDO::FETCH_ASSOC);

// Fetch history records filtered strictly by category
$stmtHistory = $conn->prepare("
    SELECT fc.*, b.batch_code, i.item_name, i.unit, i.category 
    FROM feed_consumption fc 
    JOIN batches b ON fc.batch_id = b.batch_id 
    JOIN inventory i ON fc.inventory_id = i.inventory_id 
    WHERE i.category = ?
    ORDER BY fc.date DESC, fc.consumption_id DESC
");
$stmtHistory->execute([$target_category]);
$historyRecords = $stmtHistory->fetchAll(PDO::FETCH_ASSOC);
?>

<div class="row g-4">
    <!-- Form Card -->
    <div class="col-lg-4 col-md-5">
        <div class="card p-4 shadow-sm border-0 rounded-4">
            <h4 class="card-title mb-3 text-primary fw-bold">
                <i class="fas <?php echo $section_icon; ?> me-2"></i><?php echo $form_title; ?>
            </h4>
            <p class="text-muted small mb-4">
                <?php if ($is_limestone): ?>
                    Track calcium and limestone supplementation for shell quality and layer flock nutrition.
                <?php else: ?>
                    Track daily grain, mash, and starter feeding distributed to active layer flocks.
                <?php endif; ?>
            </p>

            <?php if (!empty($message)): ?>
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i><?php echo e($message); ?>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <?php endif; ?>

            <?php if (!empty($error)): ?>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i><?php echo e($error); ?>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <?php endif; ?>
            
            <form method="POST">
                <?php echo csrf_field(); ?>
                <div class="mb-3">
                    <label class="form-label fw-bold">Select Flock / House</label>
                    <select name="batch_id" class="form-select" required>
                        <option value="">-- Choose Batch --</option>
                        <?php foreach($batches as $b): ?>
                            <option value="<?php echo (int)$b['batch_id']; ?>"><?php echo e($b['batch_code']); ?></option>
                        <?php endforeach; ?>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold"><?php echo $item_label; ?></label>
                    <select name="inventory_id" id="feedItemSelect" class="form-select" required>
                        <option value=""><?php echo $item_placeholder; ?></option>
                        <?php if (empty($inventory_items)): ?>
                            <option value="" disabled>No active <?php echo $target_category; ?> items in inventory</option>
                        <?php else: ?>
                            <?php foreach($inventory_items as $f): ?>
                                <option value="<?php echo (int)$f['inventory_id']; ?>" data-unit="<?php echo e($f['unit']); ?>">
                                    <?php echo e($f['item_name']); ?> (Stock: <?php echo number_format($f['quantity'], 1); ?> <?php echo e($f['unit']); ?>)
                                </option>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </select>
                    <?php if (empty($inventory_items)): ?>
                        <small class="text-warning mt-1 d-block">
                            <i class="fas fa-exclamation-triangle me-1"></i>Add <?php echo $target_category; ?> in <a href="inventory.php">Central Inventory</a> first.
                        </small>
                    <?php endif; ?>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Quantity Used</label>
                    <div class="input-group">
                        <input type="number" step="0.01" min="0.01" name="qty" class="form-control" placeholder="0.00" required>
                        <span class="input-group-text" id="unitDisplay">Units</span>
                    </div>
                </div>

                <div class="d-grid">
                    <button type="submit" name="consume" class="btn btn-primary btn-lg rounded-pill fw-bold">
                        <i class="fas fa-check me-2"></i><?php echo $button_text; ?>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- History Card -->
    <div class="col-lg-8 col-md-7">
        <div class="card p-4 shadow-sm border-0 rounded-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
                <h4 class="card-title mb-0 text-primary fw-bold">
                    <i class="fas fa-history me-2"></i><?php echo $history_title; ?>
                </h4>
                <span class="badge bg-primary-subtle text-primary border px-3 py-2 rounded-pill">
                    <?php echo count($historyRecords); ?> Consumption Entries
                </span>
            </div>

            <div class="table-responsive custom-scrollbar" style="max-height: 600px; overflow-y: auto;">
                <table class="table table-hover align-middle">
                    <thead class="table-light sticky-top">
                        <tr>
                            <th>Date</th>
                            <th>Batch</th>
                            <th><?php echo $history_col_header; ?></th>
                            <th class="text-end">Qty Used</th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php if (empty($historyRecords)): ?>
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox me-2"></i><?php echo $no_records_msg; ?>
                                </td>
                            </tr>
                        <?php else: ?>
                            <?php foreach($historyRecords as $row): ?>
                                <tr>
                                    <td><?php echo date('M d, Y', strtotime($row['date'])); ?></td>
                                    <td><span class="badge bg-light text-primary border"><?php echo e($row['batch_code']); ?></span></td>
                                    <td class="fw-semibold"><?php echo e($row['item_name']); ?></td>
                                    <td class="text-end fw-bold text-danger">-<?php echo number_format($row['quantity_used'], 1); ?> <?php echo e($row['unit']); ?></td>
                                </tr>
                            <?php endforeach; ?>
                        <?php endif; ?>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<?php include('footer.php'); ?>

<script>
document.getElementById('feedItemSelect')?.addEventListener('change', function() {
    const selected = this.options[this.selectedIndex];
    const unit = selected.getAttribute('data-unit');
    if (unit) {
        document.getElementById('unitDisplay').textContent = unit;
    }
});
</script>